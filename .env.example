# Google Sheets (optional — set in Netlify env for production)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# One shared tab for Contact + Instruct (Form Type column distinguishes rows)
GOOGLE_SHEET_TAB_NAME=Sheet1

# n8n webhook — primary lead path via /api/submit-lead
Lead_notification_url=
# LEAD_NOTIFICATION_URL=  # alternate env name

# Canonical site URL; used to derive `domain` in the n8n payload (www stripped)
NEXT_PUBLIC_SITE_URL=https://www.employeefraudexpert.com

# Consent-gated tracking (loaded only after user grants the matching category)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Webhook outbound keys: Full Name, Email, Phone Number, Brand name, domain
# Sheet headers (row 1, one tab): Timestamp, Brand, Form Type, Full Name, Email,
# Phone Number, Organisation, You Are, Description
